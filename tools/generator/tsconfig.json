{
  "compilerOptions": {
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  // src/assemble/** imports the production PuzzleDefinition/LayoutDefinition
  // from ../../../../src, whose extensionless imports and location outside
  // rootDir can't go through this nodenext emit without changing production
  // files or widening rootDir (pulling production copies into dist/). No
  // generator CLI needs assembly, so it stays out of this build; its
  // typecheck owner is tsconfig.workshop.json (bundler resolution), where
  // the Workshop's Final Puzzle stage calls it. Tests run under vitest.
  "exclude": ["src/**/*.test.ts", "src/assemble/**", "dist"]
}
