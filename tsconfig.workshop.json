{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.workshop.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — strict, matching tools/generator, whose modules this
       project imports (and therefore typechecks) directly. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // tools/generator/src/assemble is typechecked here, under bundler
  // resolution: it imports the production PuzzleDefinition/LayoutDefinition
  // (src/, extensionless imports) and the Workshop is its runtime caller.
  // The generator's standalone nodenext build keeps excluding it.
  "include": ["workshop/src", "tools/generator/src/assemble"]
}
