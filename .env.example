# Workshop live candidate sourcing (server-side only).
#
# Copy to .env.local (gitignored) and fill in. These are read only by the
# Workshop's Node server (npm run workshop) — they are deliberately NOT
# VITE_-prefixed, so they never reach browser code or any bundle.
# The player-facing ClueCross app does not use them.

# Anthropic API key used by the Workshop sourcing endpoint.
ANTHROPIC_API_KEY=

# Anthropic model ID used for candidate sourcing.
ANTHROPIC_MODEL=

# Workshop publishing (server-side only, never VITE_-prefixed). DIRECT
# (unpooled) Neon connection strings: the `dev` branch for local publishing
# — never `main`, the permanent calendar — and the `test` branch for the
# destructive database tests, which refuse to run unless that branch has
# the cluecross_test_branch marker table. Without PUBLISHING_DATABASE_URL
# the Workshop reports publishing as not configured.
PUBLISHING_DATABASE_URL=
PUBLISHING_TEST_DATABASE_URL=

# Player read model (server-side only, never VITE_-prefixed): a connection
# as the read-only cluecross_reader role, which can only SELECT the
# release-gated released_puzzles view (db/migrations/0002). Locally it
# points at the Neon `dev` branch. The player API must use this variable
# only — never DATABASE_URL or any owner credential.
PUZZLES_READ_DATABASE_URL=

# cluecross_reader on the `test` branch, for the destructive read-model
# security tests (same branch as PUBLISHING_TEST_DATABASE_URL).
PUBLISHING_TEST_READER_DATABASE_URL=
